{
  "$comment": "Fonte única de verdade do kit. Nenhum arquivo em src/css deve conter um valor literal de cor, família de fonte ou medida estrutural — só var(--i-*). Tamanhos de fonte e paddings próprios de um componente moram no CSS dele. Rodar `npm run build` regenera dist/tokens.css e dist/tokens.json a partir daqui.",
  "meta": {
    "prefix": "i",
    "base": "StartSe Design System",
    "fonts": "Barlow (display) + IBM Plex Sans (base)"
  },

  "color": {
    "light": {
      "canvas":        { "value": "#F7F7F7", "use": "Fundo da tela do instalador." },
      "surface":       { "value": "#FFFFFF", "use": "Cards, barra do topo, modal." },
      "surface-2":     { "value": "#FDFDFD", "use": "Superfície aninhada (demo dentro de card)." },

      "border":        { "value": "#DDDDDD", "use": "Borda de todo card. 1px, sempre." },
      "border-soft":   { "value": "#EEEEEE", "use": "Linhas internas: log, tabela, divisórias." },
      "border-strong": { "value": "#B3B3B3", "use": "Underline de campo e contorno de passo futuro." },

      "ink":           { "value": "#070707", "use": "Títulos e nomes." },
      "body":          { "value": "#2D2D2D", "use": "Texto corrido. Máx. 60ch por linha." },
      "muted":         { "value": "#797979", "use": "Rótulos, ajudas, detalhes de log." },
      "faint":         { "value": "#B3B3B3", "use": "Metadado de referência, placeholder." },

      "action":        { "value": "#0066BE", "use": "Botão primário, links, eyebrow, foco." },
      "action-hover":  { "value": "#00335F", "use": "Hover da ação — no light escurece." },
      "action-tint":   { "value": "#CCE6FB", "use": "Fundo de hover de botão de contorno." },
      "action-bg":     { "value": "#F0F7FE", "use": "Fundo de alerta informativo e opção selecionada." },

      "navy":          { "value": "#00183C", "use": "Cartão de acesso e destaque \"tem instalador\"." },
      "navy-border":   { "value": "transparent", "use": "No light o navy já contrasta com o canvas." },
      "navy-label":    { "value": "#99CCF8", "use": "Rótulos sobre navy." },
      "navy-body":     { "value": "#CCE6FB", "use": "Texto de apoio sobre navy." },
      "navy-muted":    { "value": "#7A93B8", "use": "Aviso discreto sobre navy." },

      "ok":            { "value": "#00BFB8", "use": "Checks, badge de concluído, border-top da conclusão." },
      "ok-bg":         { "value": "#E6FAF9", "use": "Fundo do bloco de conclusão e da tag Instalado." },
      "ok-ink":        { "value": "#00594F", "use": "Texto sobre ok-bg." },
      "check-ink":     { "value": "#FFFFFF", "use": "Traço do check dentro do badge teal." },

      "err":           { "value": "#FB3741", "use": "Linha do campo, mensagem e ícone de falha." },
      "err-hover":     { "value": "#C4222B", "use": "Hover do botão destrutivo." },
      "err-bg":        { "value": "#FEEBEC", "use": "Fundo do alerta de erro." },
      "err-ink":       { "value": "#93121A", "use": "Texto sobre err-bg." },

      "warn":          { "value": "#E67736", "use": "Só para condição degradada que não bloqueia." },
      "warn-bg":       { "value": "#FDF1E9", "use": "Fundo do alerta de aviso." },
      "warn-ink":      { "value": "#8A3D14", "use": "Texto sobre warn-bg." },

      "disabled-bg":   { "value": "#B3B3B3", "use": "Botão desabilitado — cor flat, nunca opacidade." },
      "disabled-ink":  { "value": "#FFFFFF", "use": "Rótulo do botão desabilitado." },

      "tag-info-bg":   { "value": "#CCE6FB", "use": "Fundo da tag INSTALADOR." },
      "tag-info-ink":  { "value": "#00335F", "use": "Texto da tag INSTALADOR." },

      "spinner-track": { "value": "#CCE6FB", "use": "Trilha do spinner; o arco usa action." }
    },

    "$comment-dark": "Patch parcial: o dark só redefine o que muda. Cores semânticas (navy, ok, err, warn) mantêm o matiz — só o fundo vira tint escuro.",
    "dark": {
      "canvas":        { "value": "#0D0D0D" },
      "surface":       { "value": "#161616" },
      "surface-2":     { "value": "#161616" },

      "border":        { "value": "#2E2E2E" },
      "border-soft":   { "value": "#242424" },
      "border-strong": { "value": "#4A4A4A" },

      "ink":           { "value": "#FDFDFD" },
      "body":          { "value": "#DDDDDD" },
      "muted":         { "value": "#B3B3B3" },
      "faint":         { "value": "#797979" },

      "action":        { "value": "#0080ED", "use": "O pure substitui o dark." },
      "action-hover":  { "value": "#3399F1", "use": "No dark o hover CLAREIA em vez de escurecer." },
      "action-tint":   { "value": "#00335F" },
      "action-bg":     { "value": "#0E1B2A" },

      "navy-border":   { "value": "#33466C", "use": "Sem ela o navy sumiria no canvas escuro." },

      "ok-bg":         { "value": "#0B1F1D" },
      "ok-ink":        { "value": "#7FE5E0" },
      "check-ink":     { "value": "#0D0D0D", "use": "Sobre o badge teal, o traço vira tinta escura." },

      "err-bg":        { "value": "#2A0F11" },
      "err-ink":       { "value": "#FC8A90" },

      "warn-bg":       { "value": "#241407" },
      "warn-ink":      { "value": "#F0A275" },

      "disabled-bg":   { "value": "#3A3A3A" },
      "disabled-ink":  { "value": "#797979" },

      "tag-info-bg":   { "value": "#00335F" },
      "tag-info-ink":  { "value": "#99CCF8" },

      "spinner-track": { "value": "#00335F" }
    }
  },

  "typography": {
    "font-display": { "value": "'Barlow', system-ui, sans-serif", "use": "Títulos de passo e de bloco." },
    "font-base":    { "value": "'IBM Plex Sans', system-ui, sans-serif", "use": "Todo o resto da interface." },
    "font-mono":    { "value": "ui-monospace, 'SF Mono', Menlo, monospace", "use": "Todo valor técnico: URL, id, métrica." }
  },

  "layout": {
    "radius":        { "value": "2px",    "use": "Só em botões e chips. Cards, inputs e tags: raio zero." },
    "control-h":     { "value": "44px",   "use": "Botões e campos de ação." },
    "control-h-sm":  { "value": "36px",   "use": "Ações secundárias da barra e de linha de log." },
    "topbar-h":      { "value": "60px",   "use": "Altura da barra do instalador." },
    "card-pad-y":    { "value": "30px",   "use": "Padding vertical do card de passo." },
    "card-pad-x":    { "value": "34px",   "use": "Padding horizontal do card de passo." },
    "shell-max":     { "value": "1200px", "use": "Largura máxima do conteúdo." },
    "shell-aside":   { "value": "290px",  "use": "Coluna fixa do stepper." },
    "shell-gap":     { "value": "44px",   "use": "Gap entre stepper e conteúdo." },
    "step-dot":      { "value": "30px",   "use": "Lado do quadrado do stepper." },
    "measure":       { "value": "60ch",   "use": "Largura máxima de texto corrido." },
    "modal-w":       { "value": "480px",  "use": "Largura do card de confirmação." }
  }
}
